# MySQL settings for the backend's mysql profile. Use your own local values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=civicconnect
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Required when running the backend with the mysql profile. Use a random value
# with at least 32 bytes; do not reuse this placeholder.
JWT_SECRET=replace_with_a_random_32_byte_or_longer_secret
JWT_EXPIRATION_SECONDS=3600

# Optional application settings for later phases.
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
